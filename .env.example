# Environment variables for Docker Compose
# Copy this file to .env and update with your actual API keys

# Database Configuration
POSTGRES_DB=indiadb_games
POSTGRES_USER=indiadb_user
POSTGRES_PASSWORD=indiadb_password

# API Keys (Get these from respective platforms)
STEAM_API_KEY=your_steam_api_key_here
EPIC_CLIENT_ID=your_epic_client_id_here
EPIC_CLIENT_SECRET=your_epic_client_secret_here
GOG_CLIENT_ID=your_gog_client_id_here
GOG_CLIENT_SECRET=your_gog_client_secret_here

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_at_least_32_characters_long
JWT_EXPIRATION=86400000

# Email Configuration (for notifications)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
